// ==========================================
// MODULE 10: CORPORATE SECRETARIAL (MCA / ROC)
// ==========================================

enum ResolutionStatus {
  DRAFT
  REVIEWED
  CIRCULATED
  APPROVED
  SIGNED
  MINUTED
}

enum MeetingType {
  BOARD_MEETING
  AUDIT_COMMITTEE
  AGM
  EGM
  RISK_COMMITTEE
  NRC
  STAKEHOLDERS_COMMITTEE
  POSTAL_BALLOT
}

enum FormFilingStatus {
  NOT_STARTED
  IN_PREPARATION
  READY_FOR_DSC
  SUBMITTED
  SRN_GENERATED
  UNDER_PROCESSING
  APPROVED
  DEFECTIVE
  RESUBMISSION_REQUIRED
  LATE_FILED
}

model SecCompany {
  id                  String             @id @default(uuid()) @db.Uuid
  cin                 String             @unique @db.VarChar(21)
  name                String
  status              String             @default("ACTIVE")
  classOfCompany      String             @map("class_of_company")
  registeredOffice    Json               @map("registered_office")
  rocOffice           String             @map("roc_office")
  dateOfIncorporation DateTime           @map("date_of_incorporation")
  authorizedCapital   Decimal            @map("authorized_capital") @db.Decimal(18,2)
  paidUpCapital       Decimal            @map("paid_up_capital") @db.Decimal(18,2)
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  directors           SecDirector[]
  shareholders        SecShareholder[]
  meetings            SecBoardMeeting[]
  resolutions         SecResolution[]
  agmNotices          SecAgmNotice[]
  minutes             SecMinutes[]
  mcaForms            SecMcaForm[]
  statutoryRegisters  SecStatutoryRegister[]
  shareCapitalHistory SecShareCapitalHistory[]
  charges             SecCharge[]
  complianceCalendar  SecComplianceCalendarItem[]
  corporateEvents     SecCorporateEvent[]
  complianceRisks     SecComplianceRisk[]
  logs                SecSecretarialLog[]

  @@map("sec_companies")
}

model SecDirector {
  id              String         @id @default(uuid()) @db.Uuid
  companyId       String         @map("company_id") @db.Uuid
  din             String         @db.VarChar(8)
  name            String
  designation     String
  appointmentDate DateTime       @map("appointment_date")
  resignationDate DateTime?      @map("resignation_date")
  status          String         @default("ACTIVE")
  email           String
  mobile          String
  pan             String         @db.VarChar(10)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  company         SecCompany     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  attendances     SecMeetingAttendee[]
  kycHistory      SecDirectorKyc[]

  @@unique([companyId, din])
  @@map("sec_directors")
}

model SecShareholder {
  id              String         @id @default(uuid()) @db.Uuid
  companyId       String         @map("company_id") @db.Uuid
  name            String
  pan             String         @db.VarChar(10)
  email           String
  phone           String
  totalShares     BigInt         @map("total_shares")
  shareType       String         @default("EQUITY") @map("share_type")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  company         SecCompany     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("sec_shareholders")
}

model SecBoardMeeting {
  id              String             @id @default(uuid()) @db.Uuid
  companyId       String             @map("company_id") @db.Uuid
  meetingNumber   Int                @map("meeting_number")
  meetingType     MeetingType        @default(BOARD_MEETING) @map("meeting_type")
  dateTime        DateTime           @map("date_time")
  locationType    String             @default("VENUE") @map("location_type")
  venue           String?
  status          String             @default("SCHEDULED")
  chairmanId      String?            @map("chairman_id") @db.Uuid
  quorumRequired  Int                @map("quorum_required")
  quorumPresent   Int?               @map("quorum_present")
  noticesSentAt   DateTime?          @map("notices_sent_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  company         SecCompany         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  attendees       SecMeetingAttendee[]
  resolutions     SecResolution[]
  minutes         SecMinutes[]

  @@map("sec_board_meetings")
}

model SecMeetingAttendee {
  id                String         @id @default(uuid()) @db.Uuid
  meetingId         String         @map("meeting_id") @db.Uuid
  directorId        String         @map("director_id") @db.Uuid
  attendanceStatus  String         @default("PRESENT") @map("attendance_status")
  modeOfAttendance  String         @default("PHYSICAL") @map("mode_of_attendance")
  joinedAt          DateTime?      @map("joined_at")
  leftAt            DateTime?      @map("left_at")
  createdAt         DateTime       @default(now()) @map("created_at")

  meeting           SecBoardMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  director          SecDirector    @relation(fields: [directorId], references: [id], onDelete: Cascade)

  @@unique([meetingId, directorId])
  @@map("sec_meeting_attendees")
}

model SecResolution {
  id                String           @id @default(uuid()) @db.Uuid
  companyId         String           @map("company_id") @db.Uuid
  meetingId         String?          @map("meeting_id") @db.Uuid
  resolutionNumber  String           @map("resolution_number")
  type              String           @default("ORDINARY")
  category          String
  agendaItem        String           @map("agenda_item")
  title             String
  draftContent      String           @db.Text @map("draft_content")
  finalizedContent  String?          @db.Text @map("finalized_content")
  status            ResolutionStatus @default(DRAFT)
  generatedByAi     Boolean          @default(false) @map("generated_by_ai")
  createdBy         String           @map("created_by") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  company           SecCompany       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  meeting           SecBoardMeeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  @@unique([companyId, resolutionNumber])
  @@map("sec_resolutions")
}

model SecAgmNotice {
  id              String         @id @default(uuid()) @db.Uuid
  companyId       String         @map("company_id") @db.Uuid
  dateOfAgm       DateTime       @map("date_of_agm")
  location        String
  clearDaysCount  Int            @map("clear_days_count")
  noticeSentDate  DateTime       @map("notice_sent_date")
  eVotingStart    DateTime?      @map("e_voting_start")
  eVotingEnd      DateTime?      @map("e_voting_end")
  proxyDeadline   DateTime       @map("proxy_deadline")
  status          String         @default("DRAFT")
  documentKey     String?        @map("document_key")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  company         SecCompany     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("sec_agm_notices")
}

model SecMinutes {
  id              String         @id @default(uuid()) @db.Uuid
  companyId       String         @map("company_id") @db.Uuid
  meetingId       String         @map("meeting_id") @db.Uuid
  meetingType     MeetingType    @map("meeting_type")
  dateTime        DateTime       @map("date_time")
  status          String         @default("DRAFT")
  currentVersion  Int            @default(1) @map("current_version")
  finalSignedKey  String?        @map("final_signed_key")
  signedAt        DateTime?      @map("signed_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  company         SecCompany     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  meeting         SecBoardMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@map("sec_minutes")
}

model SecMcaForm {
  id              String           @id @default(uuid()) @db.Uuid
  companyId       String           @map("company_id") @db.Uuid
  formType        String           @map("form_type")
  filingYear      String           @map("filing_year")
  status          FormFilingStatus @default(NOT_STARTED)
  formData        Json             @map("form_data")
  signedDscUserId String?          @map("signed_dsc_user_id") @db.Uuid
  isXbrl          Boolean          @default(false) @map("is_xbrl")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  company         SecCompany       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  srnRecords      SecSrnRecord[]

  @@map("sec_mca_forms")
}

model SecSrnRecord {
  id              String         @id @default(uuid()) @db.Uuid
  formId          String         @map("form_id") @db.Uuid
  srn             String         @unique @db.VarChar(9)
  amountPaid      Decimal        @map("amount_paid") @db.Decimal(10,2)
  challanDate     DateTime       @map("challan_date")
  status          String         @default("PAYMENT_DONE")
  errorCode       String?        @map("error_code")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  form            SecMcaForm     @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@map("sec_srn_records")
}

model SecStatutoryRegister {
  id              String         @id @default(uuid()) @db.Uuid
  companyId       String         @map("company_id") @db.Uuid
  registerType    String         @map("register_type")
  recordsData     Json           @map("records_data")
  verifiedAt      DateTime?      @map("verified_at")
  lastUpdatedBy   String         @map("last_updated_by") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  company         SecCompany     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("sec_statutory_registers")
}

model SecShareCapitalHistory {
  id              String         @id @default(uuid()) @db.Uuid
  companyId       String         @map("company_id") @db.Uuid
  classOfShares   String         @map("class_of_shares")
  authorizedShares BigInt        @map("authorized_shares")
  authorizedValue  Decimal        @map("authorized_value") @db.Decimal(18,2)
  paidUpShares    BigInt         @map("paid_up_shares")
  paidUpValue     Decimal        @map("paid_up_value") @db.Decimal(18,2)
  transactionType String         @map("transaction_type")
  createdAt       DateTime       @default(now()) @map("created_at")

  company         SecCompany     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("sec_share_capital_history")
}

model SecCharge {
  id                String       @id @default(uuid()) @db.Uuid
  companyId         String       @map("company_id") @db.Uuid
  chargeId          String       @map("charge_id")
  amount            Decimal      @db.Decimal(18,2)
  lenderName        String       @map("lender_name")
  assetDetails      String       @map("asset_details")
  creationDate      DateTime     @map("creation_date")
  modificationDate  DateTime?    @map("modification_date")
  satisfactionDate  DateTime?    @map("satisfaction_date")
  status            String       @default("OPEN")
  chg1Srn           String?      @map("chg_1_srn") @db.VarChar(9)
  chg4Srn           String?      @map("chg_4_srn") @db.VarChar(9)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  company           SecCompany   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("sec_charges")
}

model SecComplianceCalendarItem {
  id              String         @id @default(uuid()) @db.Uuid
  companyId       String         @map("company_id") @db.Uuid
  eventName       String         @map("event_name")
  dueDate         DateTime       @map("due_date")
  status          String         @default("PENDING")
  description     String
  riskCategory    String         @default("MEDIUM") @map("risk_category")
  assignedUserId  String?        @map("assigned_user_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  company         SecCompany     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("sec_compliance_calendar")
}

model SecDirectorKyc {
  id              String              @id @default(uuid()) @db.Uuid
  directorId      String              @map("director_id") @db.Uuid
  kycDueDate      DateTime            @map("kyc_due_date")
  status          String              @default("PENDING")
  panVerified     Boolean             @default(false) @map("pan_verified")
  emailVerified   Boolean             @default(false) @map("email_verified")
  mobileVerified  Boolean             @default(false) @map("mobile_verified")
  verificationDate DateTime?          @map("verification_date")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  director        SecDirector         @relation(fields: [directorId], references: [id], onDelete: Cascade)

  @@map("sec_director_kyc")
}

model SecSecretarialAudit {
  id              String         @id @default(uuid()) @db.Uuid
  companyId       String         @map("company_id") @db.Uuid
  auditYear       String         @map("audit_year")
  leadAuditorId   String         @map("lead_auditor_id") @db.Uuid
  status          String         @default("IN_PROGRESS")
  observations    Json
  risksFlagged    Int            @default(0) @map("risks_flagged")
  reportKey       String?        @map("report_key")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@map("sec_secretarial_audits")
}

model SecCorporateEvent {
  id              String         @id @default(uuid()) @db.Uuid
  companyId       String         @map("company_id") @db.Uuid
  eventType       String         @map("event_type")
  description     String
  dateOfEvent     DateTime       @map("date_of_event")
  status          String         @default("DRAFT")
  workflowsState  Json           @map("workflows_state")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  company         SecCompany     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("sec_corporate_events")
}

model SecComplianceRisk {
  id              String         @id @default(uuid()) @db.Uuid
  companyId       String         @map("company_id") @db.Uuid
  riskType        String         @map("risk_type")
  riskScore       Decimal        @map("risk_score") @db.Decimal(5,2)
  riskFactors     Json           @map("risk_factors")
  detectedAt      DateTime       @default(now()) @map("detected_at")
  status          String         @default("OPEN")

  company         SecCompany     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("sec_compliance_risks")
}

model SecSecretarialLog {
  id              String         @id @default(uuid()) @db.Uuid
  companyId       String         @map("company_id") @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  actionType      String         @map("action_type")
  description     String
  metadata        Json?
  clientIp        String?        @map("client_ip")
  createdAt       DateTime       @default(now()) @map("created_at")

