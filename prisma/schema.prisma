  workingPaper   WorkingPaper @relation(fields: [workingPaperId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [signedById], references: [id], onDelete: Restrict)

  @@unique([workingPaperId, signoffType])
  @@map("working_paper_signoffs")
}

model AuditQuery {
  id             String          @id @default(uuid()) @db.Uuid
  engagementId   String          @map("engagement_id") @db.Uuid
  queryText      String          @map("query_text") @db.Text
  status         String          @default("RAISED") @map("status")
  createdById    String          @map("created_by_id") @db.Uuid
  assignedToEmail String         @map("assigned_to_email")
  createdAt      DateTime        @default(now()) @map("created_at")

  engagement     AuditEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  responses      AuditResponse[]
  observations   AuditObservation[]

  @@map("audit_queries")
}

model AuditResponse {
  id             String     @id @default(uuid()) @db.Uuid
  queryId        String     @map("query_id") @db.Uuid
  responseText   String     @map("response_text") @db.Text
  respondedById  String     @map("responded_by_id") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at")

  query          AuditQuery @relation(fields: [queryId], references: [id], onDelete: Cascade)
  user           User       @relation(fields: [respondedById], references: [id], onDelete: Restrict)

  @@map("audit_responses")
}

model AuditObservation {
  id             String          @id @default(uuid()) @db.Uuid
  engagementId   String          @map("engagement_id") @db.Uuid
  queryId        String?         @map("query_id") @db.Uuid
  title          String
  description    String          @db.Text
  financialImpact Decimal        @default(0.0) @map("financial_impact") @db.Decimal(18,2)
  caroLinkage    String?         @map("caro_linkage")
  severity       String          @default("MEDIUM")
  createdAt      DateTime        @default(now()) @map("created_at")

  engagement     AuditEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  query          AuditQuery?     @relation(fields: [queryId], references: [id], onDelete: SetNull)

  @@map("audit_observations")
}

model SamplingPlan {
  id             String          @id @default(uuid()) @db.Uuid
  engagementId   String          @map("engagement_id") @db.Uuid
  targetLedger   String          @map("target_ledger")
