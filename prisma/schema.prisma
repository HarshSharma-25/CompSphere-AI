  invoiceNum       String               @map("invoice_num")
  invoiceDate      DateTime             @map("invoice_date")
  taxableValue     Decimal              @map("taxable_value") @db.Decimal(18,2)
  igst             Decimal              @default(0.0) @db.Decimal(18,2)
  cgst             Decimal              @default(0.0) @db.Decimal(18,2)
  sgst             Decimal              @default(0.0) @db.Decimal(18,2)
  isEligible       Boolean              @default(true) @map("is_eligible")
  blockReason      String?              @map("block_reason")
  reversalRule     String?              @map("reversal_rule")
  claimedStatus    String               @default("PENDING") @map("claimed_status")
  createdAt        DateTime             @default(now()) @map("created_at")

  gstProfile       GstProfile           @relation(fields: [gstProfileId], references: [id], onDelete: Cascade)

  @@index([gstProfileId, periodCode])
  @@map("itc_register")
}

model GstDeadline {
  id               String               @id @default(uuid()) @db.Uuid
  gstProfileId     String               @map("gst_profile_id") @db.Uuid
  returnType       String               @map("return_type")
  originalDueDate  DateTime             @map("original_due_date")
  extendedDueDate  DateTime             @map("extended_due_date")
  isCompleted      Boolean              @default(false) @map("is_completed")
  createdAt        DateTime             @default(now()) @map("created_at")

  gstProfile       GstProfile           @relation(fields: [gstProfileId], references: [id], onDelete: Cascade)

  @@map("gst_deadlines")
}

model GstAlert {
  id               String               @id @default(uuid()) @db.Uuid
  gstProfileId     String               @map("gst_profile_id") @db.Uuid
  alertType        String               @map("alert_type")
  message          String
  severity         String               @default("INFO")
  isResolved       Boolean              @default(false) @map("is_resolved")
  createdAt        DateTime             @default(now()) @map("created_at")

  gstProfile       GstProfile           @relation(fields: [gstProfileId], references: [id], onDelete: Cascade)

  @@map("gst_alerts")
}

model GstNotice {
  id               String               @id @default(uuid()) @db.Uuid
  gstProfileId     String               @map("gst_profile_id") @db.Uuid
  noticeNumber     String               @map("notice_number")
  issueDate        DateTime             @map("issue_date")
  sectionCode      String               @map("section_code")
  demandAmount     Decimal              @default(0.0) @map("demand_amount") @db.Decimal(18,2)
  status           String               @default("PENDING_RESPONSE") @map("status")
  createdAt        DateTime             @default(now()) @map("created_at")

  gstProfile       GstProfile           @relation(fields: [gstProfileId], references: [id], onDelete: Cascade)

  @@map("gst_notices")
}

model GstReturn {
  id               String            @id @default(uuid()) @db.Uuid
  gstProfileId     String            @map("gst_profile_id") @db.Uuid
  returnType       String            @map("return_type")
  periodCode       String            @map("period_code")
  status           String            @default("NOT_STARTED") @map("status")
  taxLiability     Decimal           @default(0.0) @map("tax_liability") @db.Decimal(18,2)
  itcClaimed       Decimal           @default(0.0) @map("itc_claimed") @db.Decimal(18,2)
  interestPaid     Decimal           @default(0.0) @map("interest_paid") @db.Decimal(18,2)
  lateFeePaid      Decimal           @default(0.0) @map("late_fee_paid") @db.Decimal(18,2)
  filedAt          DateTime?         @map("filed_at")
  arn              String?           @db.VarChar(100)
  payloadJson      Json?             @map("payload_json")
  createdAt        DateTime          @default(now()) @map("created_at")

  gstProfile       GstProfile        @relation(fields: [gstProfileId], references: [id], onDelete: Cascade)

  @@unique([gstProfileId, returnType, periodCode])
  @@map("gst_returns")
}

// ==========================================
// MODULE 7: NOTICES, LITIGATION & LEGAL DRAFTING
// ==========================================

model Notice {
  id               String             @id @default(uuid()) @db.Uuid
  firmId           String             @map("firm_id") @db.Uuid
  clientProfileId  String             @map("client_profile_id") @db.Uuid
  authority        String             @map("authority")
  sectionCode      String             @map("section_code")
  noticeNumber     String             @unique @map("notice_number")
  assessmentYear   String             @map("assessment_year")
  demandAmount     Decimal            @default(0.0) @map("demand_amount") @db.Decimal(18,2)
  dueDate          DateTime           @map("due_date")
  assignedStaffId  String?            @map("assigned_staff_id") @db.Uuid
  status           String             @default("RECEIVED") @map("status")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  clientProfile    ClientProfile      @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  assignedStaff    User?              @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)
  attachments      NoticeAttachment[]
  analysis         NoticeAnalysis[]
  drafts           NoticeDraft[]
  submissions      NoticeSubmission[]
  litigationCases  LitigationCase[]

  @@index([firmId, status])
  @@map("notices")
}

model NoticeAttachment {
  id        String   @id @default(uuid()) @db.Uuid
  noticeId  String   @map("notice_id") @db.Uuid
  fileKey   String   @map("file_key")
  fileName  String   @map("file_name")
  fileSize  BigInt   @map("file_size")
  createdAt DateTime @default(now()) @map("created_at")

  notice    Notice   @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@map("notice_attachments")
}

model NoticeAnalysis {
  id               String   @id @default(uuid()) @db.Uuid
  noticeId         String   @unique @map("notice_id") @db.Uuid
  summary          String   @db.Text
  issuesIdentified Json     @map("issues_identified")
  riskScore        Decimal  @map("risk_score") @db.Decimal(5,2)
  evidenceRequired Json     @map("evidence_required")
  createdAt        DateTime @default(now()) @map("created_at")

  notice           Notice   @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@map("notice_analysis")
}

model NoticeDraft {
  id             String          @id @default(uuid()) @db.Uuid
  noticeId       String          @map("notice_id") @db.Uuid
  draftContent   String          @db.Text
  defenseTone    String          @map("defense_tone")
  createdById    String          @map("created_by_id") @db.Uuid
  version        Int             @default(1)
  createdAt      DateTime        @default(now()) @map("created_at")

  notice         Notice          @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  legalDocuments LegalDocument[]

  @@map("notice_drafts")
}

model NoticeSubmission {
  id             String    @id @default(uuid()) @db.Uuid
  noticeId       String    @map("notice_id") @db.Uuid
  submissionDate DateTime  @map("submission_date")
  arn            String?   @db.VarChar(100)
  receiptUrl     String?   @map("receipt_url")
  filedById      String    @map("filed_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")

  notice         Notice    @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [filedById], references: [id], onDelete: Restrict)

  @@map("notice_submissions")
}

model CaseLaw {
  id             String              @id @default(uuid()) @db.Uuid
  citation       String              @unique
  caseName       String              @map("case_name")
  court          String
  bench          String?
  judge          String?
  decisionDate   DateTime            @map("decision_date")
  sections       String[]
  issue          String              @db.Text
  outcome        String              @map("outcome")
  fullText       String              @db.Text
  headnotes      String?             @db.Text
  ratios         String?             @db.Text
  createdAt      DateTime            @default(now()) @map("created_at")
  citations      LegalCitation[]     @relation("ReferencedCase")
  referencedBy   LegalCitation[]     @relation("SourceCase")
  embeddings     CaseLawEmbedding[]

  @@map("case_laws")
}

model CaseLawEmbedding {
  id         String   @id @default(uuid()) @db.Uuid
  caseLawId  String   @map("case_law_id") @db.Uuid
  embedding  Unsupported("vector(1536)")?
  
  caseLaw    CaseLaw  @relation(fields: [caseLawId], references: [id], onDelete: Cascade)

  @@map("case_law_embeddings")
}

model LegalCitation {
  id               String   @id @default(uuid()) @db.Uuid
  sourceCaseId     String   @map("source_case_id") @db.Uuid
  referencedCaseId String   @map("referenced_case_id") @db.Uuid
  
  sourceCase       CaseLaw  @relation("SourceCase", fields: [sourceCaseId], references: [id], onDelete: Cascade)
  referencedCase   CaseLaw  @relation("ReferencedCase", fields: [referencedCaseId], references: [id], onDelete: Cascade)

  @@map("legal_citations")
}

model LitigationCase {
  id              String             @id @default(uuid()) @db.Uuid
  noticeId        String?            @map("notice_id") @db.Uuid
  clientProfileId String             @map("client_profile_id") @db.Uuid
  caseNumber      String             @unique @map("case_number")
  forum           String
  authority       String
  demandAmount    Decimal            @default(0.0) @map("demand_amount") @db.Decimal(18,2)
  reliefAmount    Decimal            @default(0.0) @map("relief_amount") @db.Decimal(18,2)
  status          String             @default("PENDING") @map("status")
  advocateName    String?            @map("advocate_name")
  createdAt       DateTime           @default(now()) @map("created_at")

  notice          Notice?            @relation(fields: [noticeId], references: [id], onDelete: SetNull)
  clientProfile   ClientProfile      @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  hearings        Hearing[]
  orders          Order[]
  appeals         Appeal[]

  @@map("litigation_cases")
}

model Hearing {
  id               String         @id @default(uuid()) @db.Uuid
  caseId           String         @map("case_id") @db.Uuid
  hearingDate      DateTime       @map("hearing_date")
