// ==========================================
// MODULE 4: BOOKKEEPING & ACCOUNTING AUTOMATION
// ==========================================

model BankStatement {
  id            String        @id @default(uuid()) @db.Uuid
  bankAccountId String        @map("bank_account_id") @db.Uuid
  fileName      String        @map("file_name")
  importDate    DateTime      @default(now()) @map("import_date")
  startDate     DateTime      @map("start_date")
  endDate       DateTime      @map("end_date")
  status        String        @default("PENDING") @map("status")
  checksum      String        @map("checksum") @db.VarChar(64)
  
  bankAccount   BankAccount   @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  transactions  Transaction[]

  @@map("bank_statements")
}

model Transaction {
  id             String               @id @default(uuid()) @db.Uuid
  bankAccountId  String               @map("bank_account_id") @db.Uuid
  statementId    String?              @map("statement_id") @db.Uuid
  transactionDate DateTime            @map("transaction_date")
  rawNarration   String               @map("raw_narration")
  amount         Decimal              @db.Decimal(18,2)
  type           String               @map("type")
  referenceNum   String?              @map("reference_num")
  status         String               @default("PENDING_REVIEW") @map("status")
  createdAt      DateTime             @default(now()) @map("created_at")

  bankAccount    BankAccount          @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  bankStatement  BankStatement?       @relation(fields: [statementId], references: [id], onDelete: SetNull)
  cleaningLogs   TransactionCleaning[]
  mappings       LedgerMapping[]
  journalEntries JournalEntry[]
  duplicateFlags DuplicateFlag[]      @relation("TargetTransaction")
  duplicateOf    DuplicateFlag[]      @relation("SourceTransaction")

  @@index([bankAccountId, transactionDate])
  @@map("transactions")
}

model TransactionCleaning {
  id             String      @id @default(uuid()) @db.Uuid
  transactionId  String      @map("transaction_id") @db.Uuid
  cleanedMerchant String      @map("cleaned_merchant")
  paymentChannel String      @map("payment_channel")
  confidenceScore Decimal     @map("confidence_score") @db.Decimal(5,2)
  isCorrected    Boolean     @default(false) @map("is_corrected")
  correctedBy    String?     @map("corrected_by") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at")

  transaction    Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@map("transaction_cleaning")
}

model ChartOfAccounts {
  id              String           @id @default(uuid()) @db.Uuid
  firmId          String           @map("firm_id") @db.Uuid
  clientProfileId String           @map("client_profile_id") @db.Uuid
  version         Int              @default(1)
  isLocked        Boolean          @default(false) @map("is_locked")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  
  accountGroups   AccountGroup[]
  ledgerAccounts  LedgerAccount[]
  mappingRules    MappingRule[]

  clientProfile   ClientProfile    @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)

  @@unique([firmId, clientProfileId, version])
  @@map("chart_of_accounts")
}

model AccountGroup {
  id                 String           @id @default(uuid()) @db.Uuid
  coaId              String           @map("coa_id") @db.Uuid
  parentId           String?          @map("parent_id") @db.Uuid
  name               String
  code               String           @db.VarChar(50)
  scheduleIiiMapping String?          @map("schedule_iii_mapping")
  
  coa                ChartOfAccounts  @relation(fields: [coaId], references: [id], onDelete: Cascade)
  parent             AccountGroup?    @relation("GroupHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children           AccountGroup[]   @relation("GroupHierarchy")
  ledgerAccounts     LedgerAccount[]

  @@unique([coaId, code])
  @@map("account_groups")
}

model LedgerAccount {
  id             String          @id @default(uuid()) @db.Uuid
  coaId          String          @map("coa_id") @db.Uuid
  groupId        String          @map("group_id") @db.Uuid
  name           String
  code           String          @db.VarChar(50)
  gstin          String?         @db.VarChar(15)
  pan            String?         @db.VarChar(10)
  openingBalance Decimal         @default(0.0) @map("opening_balance") @db.Decimal(18,2)
  currentBalance Decimal         @default(0.0) @map("current_balance") @db.Decimal(18,2)
  createdAt      DateTime        @default(now()) @map("created_at")

  coa            ChartOfAccounts @relation(fields: [coaId], references: [id], onDelete: Cascade)
  group          AccountGroup    @relation(fields: [groupId], references: [id], onDelete: Restrict)
  debitLines     JournalLine[]   @relation("DebitAccount")
  creditLines    JournalLine[]   @relation("CreditAccount")
  mappingRules   MappingRule[]

  @@unique([coaId, code])
  @@map("ledger_accounts")
}

model LedgerMapping {
  id             String        @id @default(uuid()) @db.Uuid
  transactionId  String        @map("transaction_id") @db.Uuid
  debitAccountId String?       @map("debit_account_id") @db.Uuid
  creditAccountId String?      @map("credit_account_id") @db.Uuid
  confidenceScore Decimal      @map("confidence_score") @db.Decimal(5,2)
  mappingSource  String        @default("AI") @map("mapping_source")
  createdAt      DateTime      @default(now()) @map("created_at")

  transaction    Transaction   @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@map("ledger_mappings")
}

model MappingRule {
  id              String          @id @default(uuid()) @db.Uuid
  coaId           String          @map("coa_id") @db.Uuid
  ruleType        String          @default("CLIENT") @map("rule_type")
  priority        Int             @default(1)
  pattern         String
  targetAccountId String          @map("target_account_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at")

  coa             ChartOfAccounts @relation(fields: [coaId], references: [id], onDelete: Cascade)
  targetAccount   LedgerAccount   @relation(fields: [targetAccountId], references: [id], onDelete: Cascade)

  @@map("mapping_rules")
}

model JournalEntry {
  id             String        @id @default(uuid()) @db.Uuid
  transactionId  String?       @unique @map("transaction_id") @db.Uuid
  voucherNumber  String        @map("voucher_number") @db.VarChar(100)
  entryDate      DateTime      @map("entry_date")
  narration      String        @db.Text
  voucherType    String        @map("voucher_type")
  status         String        @default("DRAFT") @map("status")
  isPeriodLocked Boolean       @default(false) @map("is_period_locked")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  transaction    Transaction?  @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  lines          JournalLine[]

  @@map("journal_entries")
}

model JournalLine {
  id             String        @id @default(uuid()) @db.Uuid
  entryId        String        @map("entry_id") @db.Uuid
  debitAccountId String?       @map("debit_account_id") @db.Uuid
  creditAccountId String?      @map("credit_account_id") @db.Uuid
  amount         Decimal       @db.Decimal(18,2)
  gstRate        Decimal?      @map("gst_rate") @db.Decimal(5,2)
  gstType        String?       @map("gst_type")
  isItcEligible  Boolean       @default(true) @map("is_itc_eligible")
  
  entry          JournalEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  debitAccount   LedgerAccount? @relation("DebitAccount", fields: [debitAccountId], references: [id], onDelete: Restrict)
  creditAccount  LedgerAccount? @relation("CreditAccount", fields: [creditAccountId], references: [id], onDelete: Restrict)

  @@map("journal_lines")
}

model DuplicateFlag {
  id                  String      @id @default(uuid()) @db.Uuid
  sourceTransactionId String      @map("source_transaction_id") @db.Uuid
  targetTransactionId String      @map("target_transaction_id") @db.Uuid
  confidenceScore     Decimal     @map("confidence_score") @db.Decimal(5,2)
  status              String      @default("UNRESOLVED") @map("status")
  createdAt           DateTime    @default(now()) @map("created_at")

  sourceTransaction   Transaction @relation("SourceTransaction", fields: [sourceTransactionId], references: [id], onDelete: Cascade)
  targetTransaction   Transaction @relation("TargetTransaction", fields: [targetTransactionId], references: [id], onDelete: Cascade)

  @@unique([sourceTransactionId, targetTransactionId])
  @@map("duplicate_flags")
}

// ==========================================
// MODULE 5: GST COMPLIANCE MANAGEMENT
// ==========================================

model ReconciliationSession {
  id               String               @id @default(uuid()) @db.Uuid
  gstProfileId     String               @map("gst_profile_id") @db.Uuid
  periodCode       String               @map("period_code")
  reconciledById   String               @map("reconciled_by_id") @db.Uuid
  matchedCount     Int                  @default(0) @map("matched_count")
  mismatchedCount  Int                  @default(0) @map("mismatched_count")
  createdAt        DateTime             @default(now()) @map("created_at")

  gstProfile       GstProfile           @relation(fields: [gstProfileId], references: [id], onDelete: Cascade)
  user             User                 @relation(fields: [reconciledById], references: [id], onDelete: Restrict)
  reconciliationItems ReconciliationItem[]

  @@map("reconciliation_sessions")
}

model ReconciliationItem {
  id               String                @id @default(uuid()) @db.Uuid
  sessionId        String                @map("session_id") @db.Uuid
  invoiceNum       String                @map("invoice_num")
  invoiceDate      DateTime              @map("invoice_date")
  vendorGstin      String                @map("vendor_gstin")
  booksAmount      Decimal               @db.Decimal(18,2)
  gst2bAmount      Decimal               @db.Decimal(18,2)
  status           String                @map("status")
