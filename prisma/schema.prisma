model Employee {
  id               String            @id @default(uuid()) @db.Uuid
  firmId           String            @map("firm_id") @db.Uuid
  clientProfileId  String            @map("client_profile_id") @db.Uuid
  employeeCode     String            @map("employee_code") @db.VarChar(50)
  firstName        String            @map("first_name")
  lastName         String            @map("last_name")
  pan              String            @db.VarChar(10)
  aadhaar          String            @db.VarChar(12)
  email            String
  phone            String?
  uan              String?           @db.VarChar(12)
  esiNumber        String?           @map("esi_number") @db.VarChar(17)
  joiningDate      DateTime          @map("joining_date")
  exitDate         DateTime?         @map("exit_date")
  bankAccountNum   String?           @map("bank_account_num")
  ifscCode         String?           @map("ifsc_code") @db.VarChar(11)
  status           String            @default("ACTIVE") @map("status")
  createdAt        DateTime          @default(now()) @map("created_at")

  clientProfile    ClientProfile     @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  salaryStructures SalaryStructure[]
  attendanceLogs   Attendance[]
  payrollDetails   PayrollDetail[]
  pfRecords        PfRecord[]
  esiRecords       EsiRecord[]
  ptRecords        PtRecord[]
  lwfRecords       LwfRecord[]
  tdsRecords       TdsRecord[]
  payslips         Payslip[]
  bonusRecords     BonusRecord[]
  gratuityRecords  GratuityRecord[]
  settlements      Settlement[]

  @@unique([clientProfileId, employeeCode])
  @@map("employees")
}

model SalaryStructure {
  id            String            @id @default(uuid()) @db.Uuid
  employeeId    String            @map("employee_id") @db.Uuid
  effectiveFrom DateTime          @map("effective_from")
  basic         Decimal           @db.Decimal(18,2)
  hra           Decimal           @db.Decimal(18,2)
  specialAllow  Decimal           @map("special_allow") @db.Decimal(18,2)
