model AuditEngagement {
  id               String            @id @default(uuid()) @db.Uuid
  firmId           String            @map("firm_id") @db.Uuid
  clientProfileId  String            @map("client_profile_id") @db.Uuid
  financialYear    String            @map("financial_year")
  engagementType   String            @map("engagement_type")
  status           String            @default("PLANNING") @map("status")
  overallMateriality Decimal         @map("overall_materiality") @db.Decimal(18,2)
  performanceMateriality Decimal       @map("performance_materiality") @db.Decimal(18,2)
  tolerableError   Decimal           @map("tolerable_error") @db.Decimal(18,2)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  exceptions       AuditException[]
  fraudAlerts      FraudAlert[]
  fraudCases       FraudCase[]
  workingPapers    WorkingPaper[]
  queries          AuditQuery[]
  samplingPlans    SamplingPlan[]
  auditReports     AuditReport[]
  evidence         AuditEvidence[]

  clientProfile    ClientProfile     @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)

  @@unique([firmId, clientProfileId, financialYear, engagementType])
  @@map("audit_engagements")
}

model AuditRule {
  id               String             @id @default(uuid()) @db.Uuid
  firmId           String             @map("firm_id") @db.Uuid
  name             String
  code             String             @unique
  description      String?
  ruleScript       String             @map("rule_script")
  isActive         Boolean            @default(true) @map("is_active")
  createdAt        DateTime           @default(now()) @map("created_at")
  versions         AuditRuleVersion[]

  @@map("audit_rules")
}

model AuditRuleVersion {
  id          String    @id @default(uuid()) @db.Uuid
  ruleId      String    @map("rule_id") @db.Uuid
  versionNum  Int       @map("version_num")
  ruleScript  String    @map("rule_script")
  updatedById String    @map("updated_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  
  rule        AuditRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([ruleId, versionNum])
  @@map("audit_rule_versions")
}

model AuditException {
  id             String          @id @default(uuid()) @db.Uuid
  engagementId   String          @map("engagement_id") @db.Uuid
  ruleCode       String          @map("rule_code")
  transactionId  String?         @map("transaction_id") @db.Uuid
  description    String
  severity       String          @default("MEDIUM") @map("severity")
  status         String          @default("UNRESOLVED") @map("status")
  managementReply String?        @map("management_reply")
  createdAt      DateTime        @default(now()) @map("created_at")

  engagement     AuditEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@index([engagementId, status])
  @@map("audit_exceptions")
}

model FraudAlert {
  id             String          @id @default(uuid()) @db.Uuid
  engagementId   String          @map("engagement_id") @db.Uuid
  scenarioType   String          @map("scenario_type")
  detectedOnId   String          @map("detected_on_id")
  deviationScore Decimal         @map("deviation_score") @db.Decimal(5,2)
  status         String          @default("NEW") @map("status")
  createdAt      DateTime        @default(now()) @map("created_at")

  engagement     AuditEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@map("fraud_alerts")
}

model FraudCase {
  id             String          @id @default(uuid()) @db.Uuid
  engagementId   String          @map("engagement_id") @db.Uuid
  title          String
  caseDetails    String          @map("case_details") @db.Text
  status         String          @default("OPEN") @map("status")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  engagement     AuditEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@map("fraud_cases")
}

model WorkingPaperTemplate {
  id             String         @id @default(uuid()) @db.Uuid
  saCode         String         @unique @map("sa_code")
  title          String
  defaultContent String         @db.Text
  createdAt      DateTime       @default(now()) @map("created_at")
  papers         WorkingPaper[]

  @@map("working_paper_templates")
}

model WorkingPaper {
  id             String               @id @default(uuid()) @db.Uuid
  engagementId   String               @map("engagement_id") @db.Uuid
  templateId     String               @map("template_id") @db.Uuid
