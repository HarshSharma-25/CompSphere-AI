model VendorRiskHistory {
  id               String                @id @default(uuid()) @db.Uuid
  scoreId          String                @map("score_id") @db.Uuid
  scoreCaptured    Decimal               @map("score_captured") @db.Decimal(5,2)
  assessmentPeriod String                @map("assessment_period")
  createdAt        DateTime              @default(now()) @map("created_at")

  vendorScore      VendorComplianceScore @relation(fields: [scoreId], references: [id], onDelete: Cascade)

  @@map("vendor_risk_history")
}

model ItcRegister {
  id               String               @id @default(uuid()) @db.Uuid
  gstProfileId     String               @map("gst_profile_id") @db.Uuid
  periodCode       String               @map("period_code")
