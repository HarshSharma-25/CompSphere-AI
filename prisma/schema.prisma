datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum NotificationType {
  ALERT
  TASK
  COMPLIANCE
  SYSTEM
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum AccessRole {
  SUPER_ADMIN
  ADMIN
  CA_PARTNER
  SENIOR_STAFF
  JUNIOR_STAFF
  ARTICLE
  BILLING_STAFF
  CLIENT
}

model User {
  id                 String             @id @default(uuid()) @db.Uuid
  email              String             @unique
  passwordHash       String             @map("password_hash")
  firstName          String             @map("first_name")
  lastName           String             @map("last_name")
  phone              String?
  isTwoFactorEnabled Boolean            @default(false) @map("is_two_factor_enabled")
  twoFactorSecret    String?            @map("two_factor_secret")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  deletedAt          DateTime?          @map("deleted_at")
  
  firmAccesses       FirmAccess[]
  notifications      Notification[]
  activities         Activity[]
  userPreferences    UserPreference[]
  searchHistory      SearchHistory[]
  sessions           Session[]
  auditLogs          AuditLog[]
  
  // Dynamic relations from new modules
  uploadedVersions   DocumentVersion[]
  ocrFeedbacks       OcrFeedback[]
  ruleVersions       AuditRuleVersion[]
  paperSignoffs      WorkingPaperSignoff[]
  auditQueries       AuditQuery[]
  auditResponses     AuditResponse[]
  reconSessions      ReconciliationSession[]
  placedHolds        LegalHold[]        @relation("PlacedHolds")
  releasedHolds      LegalHold[]        @relation("ReleasedHolds")
  noticeDrafts       NoticeDraft[]
  noticeSubmissions  NoticeSubmission[]
  staffAssignments   StaffAssignment[]
  quizAttempts       QuizAttempt[]
  certificates       Certificate[]

  @@map("users")
}

model Firm {
  id           String             @id @default(uuid()) @db.Uuid
  name         String
  tradeName    String?            @map("trade_name")
  pan          String             @unique @db.VarChar(10)
  gstin        String?            @unique @db.VarChar(15)
  address      Json?
  status       String             @default("active")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  firmAccesses FirmAccess[]
  clients      Client[]
  activities   Activity[]
  searchHistory SearchHistory[]
  userPreferences UserPreference[]

  @@map("firms")
}

model Client {
  id         String   @id @default(uuid()) @db.Uuid
  firmId     String   @map("firm_id") @db.Uuid
  name       String
  tradeName  String?  @map("trade_name")
  pan String @db.VarChar(10)
  gstin String? @db.VarChar(15)
  email      String?
  phone      String?
  status     String   @default("active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  firm       Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  profile    ClientProfile?

  @@index([firmId])
  @@index([pan])
  @@index([gstin])
  @@map("clients")
}

model FirmAccess {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  firmId    String     @map("firm_id") @db.Uuid
  role      AccessRole @default(ARTICLE)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  firm      Firm       @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@unique([userId, firmId])
  @@index([firmId])
  @@map("firm_access")
}

model Notification {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  title     String
  message   String
  type      NotificationType   @default(SYSTEM)
  status    NotificationStatus @default(UNREAD)
  metadata  Json?
  createdAt DateTime           @default(now()) @map("created_at")
  readAt    DateTime?          @map("read_at")

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("notifications")
}

model Activity {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  firmId     String   @map("firm_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firm       Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([firmId, createdAt])
  @@map("activities")
}

model UserPreference {
  id               String  @id @default(uuid()) @db.Uuid
  userId           String  @map("user_id") @db.Uuid
  activeFirmId     String? @map("active_firm_id") @db.Uuid
  theme            String  @default("system")
  sidebarCollapsed Boolean @default(false) @map("sidebar_collapsed")
  quickLinks       Json?   @map("quick_links")

  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeFirm       Firm?   @relation(fields: [activeFirmId], references: [id], onDelete: SetNull)

  @@unique([userId])
  @@map("user_preferences")
}

model SearchHistory {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  firmId       String   @map("firm_id") @db.Uuid
  query        String
  targetType   String?  @map("target_type")
  targetId     String?  @map("target_id")
  createdAt    DateTime @default(now()) @map("created_at")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firm         Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([userId, firmId])
  @@map("search_history")
}

model Session {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  refreshTokenHash  String   @map("refresh_token_hash")
  ipAddress         String?  @map("ip_address")
  userAgent         String?  @map("user_agent")
  expiresAt         DateTime @map("expires_at")
  isRevoked         Boolean  @default(false) @map("is_revoked")
  createdAt         DateTime @default(now()) @map("created_at")

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  action    String
  details   Json
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

model DashboardWidget {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  firmId     String   @map("firm_id") @db.Uuid
  widgetKey  String   @map("widget_key")
  positionX  Int      @map("position_x")
  positionY  Int      @map("position_y")
  width      Int
  height     Int
  isVisible  Boolean  @default(true) @map("is_visible")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([userId, firmId, widgetKey])
  @@map("dashboard_widgets")
}

// ==========================================
// MODULE 2: AI CLIENT ONBOARDING
// ==========================================

model ClientProfile {
  id                   String            @id @default(uuid()) @db.Uuid
  clientId             String            @unique @map("client_id") @db.Uuid
  legalName            String            @map("legal_name")
  tradeName            String?           @map("trade_name")
  entityType           String            @map("entity_type")
  constitutionOfBusiness String?         @map("constitution_of_business")
  dateOfIncorporation  DateTime?         @map("date_of_incorporation")
  turnoverRange        String?           @map("turnover_range")
  employeeCount        Int               @default(0) @map("employee_count")
  industrySector       String?           @map("industry_sector")
  riskScore            String            @default("LOW") @map("risk_score")
  riskNotes            String?           @map("risk_notes")
  kycStatus            String            @default("PENDING") @map("kyc_status")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  client               Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  gstProfile           GstProfile?
  panProfile           PanProfile?
  cinProfile           CinProfile?
  directors            Director[]
  bankAccounts         BankAccount[]
  signatories          Signatory[]
  engagementLetters    EngagementLetter[]
  tagAssignments       TagAssignment[]
  staffAssignments     StaffAssignment[]
  documents            Document[]
  notices              Notice[]
  litigationCases      LitigationCase[]
  incomeTaxProfile     IncomeTaxProfile?
  employees            Employee[]
  payrollRuns          PayrollRun[]
  coa                  ChartOfAccounts[]

  @@map("client_profiles")
}

model GstProfile {
  id                 String        @id @default(uuid()) @db.Uuid
  clientProfileId    String        @unique @map("client_profile_id") @db.Uuid
  gstin              String        @unique @db.VarChar(15)
  registrationDate   DateTime?     @map("registration_date")
  taxpayerType       String?       @map("taxpayer_type")
  gstStatus          String        @map("gst_status")
  filingFrequency    String        @default("MONTHLY") @map("filing_frequency")
  jurisdictionState  String?       @map("jurisdiction_state")
  jurisdictionCenter String?       @map("jurisdiction_center")
  lastLookupAt       DateTime?     @map("last_lookup_at")

  clientProfile      ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  returns            GstReturn[]
  reconciliations    ReconciliationSession[]
  itcRegister        ItcRegister[]
  deadlines          GstDeadline[]
  alerts             GstAlert[]
  notices            GstNotice[]

  @@map("gst_profiles")
}

model PanProfile {
  id              String        @id @default(uuid()) @db.Uuid
  clientProfileId String        @unique @map("client_profile_id") @db.Uuid
  pan             String        @unique @db.VarChar(10)
  panStatus       String        @map("pan_status")
  holderName      String        @map("holder_name")
  category        String?       @map("category")
  aadhaarSeeding  String?       @map("aadhaar_seeding")
  lastLookupAt    DateTime?     @map("last_lookup_at")

  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)

  @@map("pan_profiles")
}

model CinProfile {
  id              String        @id @default(uuid()) @db.Uuid
  clientProfileId String        @unique @map("client_profile_id") @db.Uuid
  cin             String        @unique @db.VarChar(21)
  cinStatus       String        @map("cin_status")
  authorizedCapital Decimal     @map("authorized_capital") @db.Decimal(18,2)
  paidUpCapital   Decimal       @map("paid_up_capital") @db.Decimal(18,2)
  rocOffice       String?       @map("roc_office")
  classOfCompany  String?       @map("class_of_company")
  lastLookupAt    DateTime?     @map("last_lookup_at")

  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)

  @@map("cin_profiles")
}

model Director {
  id              String        @id @default(uuid()) @db.Uuid
  clientProfileId String        @map("client_profile_id") @db.Uuid
  din             String        @db.VarChar(8)
  name            String
  designation     String
  appointmentDate DateTime      @map("appointment_date")
  status          String        @default("active")
  pan             String?       @db.VarChar(10)
  createdAt       DateTime      @default(now()) @map("created_at")

  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)

  @@unique([clientProfileId, din])
  @@map("directors")
}

model BankAccount {
  id              String        @id @default(uuid()) @db.Uuid
  clientProfileId String        @map("client_profile_id") @db.Uuid
  accountNumber   String        @map("account_number")
  bankName        String        @map("bank_name")
  ifsc            String        @db.VarChar(11)
  branchName      String?       @map("branch_name")
  accountType     String        @default("CURRENT") @map("account_type")
  isPrimary       Boolean       @default(false) @map("is_primary")
  isVerified      Boolean       @default(false) @map("is_verified")
  createdAt       DateTime      @default(now()) @map("created_at")
  
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  statements      BankStatement[]
  transactions    Transaction[]

  @@map("bank_accounts")
}

model Signatory {
  id              String        @id @default(uuid()) @db.Uuid
  clientProfileId String        @map("client_profile_id") @db.Uuid
  name            String
  email           String
  phone           String
  pan             String        @db.VarChar(10)
  din             String?       @db.VarChar(8)
  isAuthorized    Boolean       @default(true) @map("is_authorized")
  createdAt       DateTime      @default(now()) @map("created_at")

  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)

  @@map("signatories")
}

model EngagementTemplate {
  id            String             @id @default(uuid()) @db.Uuid
  title         String
  content       String             @db.Text
  version       String             @default("1.0.0")
  isActive      Boolean            @default(true) @map("is_active")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  letters       EngagementLetter[]

  @@map("engagement_templates")
}

model EngagementLetter {
  id            String             @id @default(uuid()) @db.Uuid
  clientProfileId String           @map("client_profile_id") @db.Uuid
  templateId    String             @map("template_id") @db.Uuid
  pdfUrl        String?            @map("pdf_url")
  status        String             @default("DRAFT") @map("status")
  sentAt        DateTime?          @map("sent_at")
  signedAt      DateTime?          @map("signed_at")
  signedIp      String?            @map("signed_ip")
  signatureHash String?            @map("signature_hash")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  clientProfile ClientProfile      @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  template      EngagementTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@map("engagement_letters")
}

model ClientTag {
  id             String          @id @default(uuid()) @db.Uuid
  firmId         String          @map("firm_id") @db.Uuid
  name           String
  color          String          @default("#5B4FE9")
  isSystem       Boolean         @default(false) @map("is_system")
  createdAt      DateTime        @default(now()) @map("created_at")
  tagAssignments TagAssignment[]

  @@unique([firmId, name])
  @@map("client_tags")
}

model TagAssignment {
  id              String        @id @default(uuid()) @db.Uuid
  clientProfileId String        @map("client_profile_id") @db.Uuid
  tagId           String        @map("tag_id") @db.Uuid
  assignedAt      DateTime      @default(now()) @map("assigned_at")

  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  tag             ClientTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([clientProfileId, tagId])
  @@map("tag_assignments")
}

model OnboardingSession {
  id             String   @id @default(uuid()) @db.Uuid
  firmId         String   @map("firm_id") @db.Uuid
  currentStep    Int      @default(1) @map("current_step")
  stepData       Json     @map("step_data")
  status         String   @default("IN_PROGRESS") @map("status")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([firmId])
  @@map("onboarding_sessions")
}

model ImportJob {
  id             String      @id @default(uuid()) @db.Uuid
  firmId         String      @map("firm_id") @db.Uuid
  fileName       String      @map("file_name")
  totalRows      Int         @map("total_rows")
  processedRows  Int         @default(0) @map("processed_rows")
  failedRows     Int         @default(0) @map("failed_rows")
  status         String      @default("PENDING") @map("status")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  logs           ImportLog[]

  @@map("import_jobs")
}

model ImportLog {
  id         String    @id @default(uuid()) @db.Uuid
  jobId      String    @map("job_id") @db.Uuid
  rowNumber  Int       @map("row_number")
  status     String    @map("status")
  message    String?
  rowData    Json?     @map("row_data")
  createdAt  DateTime  @default(now()) @map("created_at")
  
  job        ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("import_logs")
}

model StaffAssignment {
  id              String        @id @default(uuid()) @db.Uuid
  clientProfileId String        @map("client_profile_id") @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  roleType        String        @default("PRIMARY_CA") @map("role_type")
  assignedAt      DateTime      @default(now()) @map("assigned_at")
  revokedAt       DateTime?     @map("revoked_at")

  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("staff_assignments")
}

model TrainingModule {
  id          String         @id @default(uuid()) @db.Uuid
  title       String
  description String
  videoUrl    String?        @map("video_url")
  learningPath String        @default("GENERAL_AUDIT") @map("learning_path")
  difficulty  String         @default("BEGINNER")
  tasks       TrainingTask[]

  @@map("training_modules")
}

model TrainingTask {
  id             String         @id @default(uuid()) @db.Uuid
  moduleId       String         @map("module_id") @db.Uuid
  title          String
  orderIndex     Int            @map("order_index")
  pointsValue    Int            @default(10) @map("points_value")
  module         TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  quizAttempts   QuizAttempt[]

  @@map("training_tasks")
}

model QuizAttempt {
  id        String       @id @default(uuid()) @db.Uuid
  taskId    String       @map("task_id") @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  score     Int
  passed    Boolean      @default(false)
  createdAt DateTime     @default(now()) @map("created_at")

  task      TrainingTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("quiz_attempts")
}

model Certificate {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  moduleName  String   @map("module_name")
  issuedAt    DateTime @default(now()) @map("issued_at")
  verifyToken String   @unique @map("verify_token") @db.VarChar(64)

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("certificates")
}

// ==========================================
// MODULE 3: DOCUMENT MANAGEMENT SYSTEM
// ==========================================

model DocumentFolder {
  id              String           @id @default(uuid()) @db.Uuid
  parentId        String?          @map("parent_id") @db.Uuid
  firmId          String           @map("firm_id") @db.Uuid
  clientProfileId String           @map("client_profile_id") @db.Uuid
  name            String
  path            String           @db.VarChar(1024)
  isSystem        Boolean          @default(false) @map("is_system")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  parent          DocumentFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children        DocumentFolder[] @relation("FolderHierarchy")
  documents       Document[]

  @@unique([firmId, clientProfileId, parentId, name])
  @@index([firmId, clientProfileId])
  @@map("document_folders")
}

model Document {
  id               String               @id @default(uuid()) @db.Uuid
  folderId         String               @map("folder_id") @db.Uuid
  clientProfileId  String               @map("client_profile_id") @db.Uuid
  name             String
  mimeType         String               @map("mime_type")
  fileSize         BigInt               @map("file_size")
  currentVersion   Int                  @default(1) @map("current_version")
  md5Checksum      String               @map("md5_checksum") @db.VarChar(32)
  isDeleted        Boolean              @default(false) @map("is_deleted")
  activeLegalHold  Boolean              @default(false) @map("active_legal_hold")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  folder           DocumentFolder       @relation(fields: [folderId], references: [id], onDelete: Cascade)
  clientProfile    ClientProfile        @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  versions         DocumentVersion[]
  reviews          DocumentReview[]
  statuses         DocumentStatus[]
  expiries         DocumentExpiry[]
  uploads          DocumentUpload[]
  accessLogs       DocumentAccessLog[]
  legalHolds       LegalHold[]

  @@index([clientProfileId])
  @@index([folderId])
  @@map("documents")
}

model DocumentVersion {
  id            String    @id @default(uuid()) @db.Uuid
  documentId    String    @map("document_id") @db.Uuid
  versionNumber Int       @map("version_number")
  fileKey       String    @map("file_key")
  fileSize      BigInt    @map("file_size")
  md5Checksum   String    @map("md5_checksum") @db.VarChar(32)
  uploadedById  String    @map("uploaded_by_id") @db.Uuid
  changeSummary String?   @map("change_summary")
  createdAt     DateTime  @map("created_at")

  document      Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  ocrJobs       OcrJob[]

  @@unique([documentId, versionNumber])
  @@map("document_versions")
}

model DocumentRequest {
  id              String              @id @default(uuid()) @db.Uuid
  firmId          String              @map("firm_id") @db.Uuid
  clientProfileId String              @map("client_profile_id") @db.Uuid
  title           String
  description     String?
  documentType    String              @map("document_type")
  dueDate         DateTime            @map("due_date")
  status          String              @default("PENDING") @map("status")
  createdById     String              @map("created_by_id") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at")
  
  user            User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  uploads         DocumentUpload[]
  reminders       DocumentReminder[]

  @@index([firmId, clientProfileId])
  @@map("document_requests")
}

model DocumentUpload {
  id         String          @id @default(uuid()) @db.Uuid
  requestId  String?         @map("request_id") @db.Uuid
  documentId String          @map("document_id") @db.Uuid
  source     String          @default("PORTAL") @map("source")
  status     String          @default("PENDING_REVIEW") @map("status")
  createdAt  DateTime        @default(now()) @map("created_at")

  request    DocumentRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  document   Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_uploads")
}

model OcrJob {
  id                String          @id @default(uuid()) @db.Uuid
  documentVersionId String          @map("document_version_id") @db.Uuid
  status            String          @default("PENDING") @map("status")
  confidenceScore   Decimal?        @map("confidence_score") @db.Decimal(5,2)
  errorMessage      String?         @map("error_message")
  createdAt         DateTime        @default(now()) @map("created_at")
  processedAt       DateTime?       @map("processed_at")

  version           DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  ocrResults        OcrResult[]

  @@map("ocr_jobs")
}

model OcrResult {
  id             String        @id @default(uuid()) @db.Uuid
  jobId          String        @map("job_id") @db.Uuid
  extractedData  Json          @map("extracted_data")
  rawText        String        @db.Text
  classifiedType String        @map("classified_type")
  createdAt      DateTime      @default(now()) @map("created_at")

  job            OcrJob        @relation(fields: [jobId], references: [id], onDelete: Cascade)
