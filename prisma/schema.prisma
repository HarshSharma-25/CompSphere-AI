  lastTriggered    DateTime?   @map("last_triggered")
  createdAt        DateTime    @default(now()) @map("created_at")
  report           RepReport   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("rep_schedules")
}

model RepHistory {
  id              String      @id @default(uuid()) @db.Uuid
  reportId        String      @map("report_id") @db.Uuid
  generatedBy     String?     @map("generated_by") @db.Uuid
  filtersApplied  Json        @map("filters_applied")
  executionTimeMs Int         @default(0) @map("execution_time_ms")
  status          String      @default("SUCCESS") @db.VarChar(50)
  errorMessage    String?     @map("error_message")
  createdAt       DateTime    @default(now()) @map("created_at")
  report          RepReport   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  exports         RepExport[]

  @@map("rep_history")
}

model RepVersion {
  id         String    @id @default(uuid()) @db.Uuid
  reportId   String    @map("report_id") @db.Uuid
  version    String    @db.VarChar(50)
  status     String    @default("DRAFT") @db.VarChar(50)
  changeNote String?   @map("change_note") @db.VarChar(255)
  payload    Json
  createdBy  String?   @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  report     RepReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("rep_versions")
}

model RepExport {
  id                   String             @id @default(uuid()) @db.Uuid
  historyId            String             @map("history_id") @db.Uuid
  exportFormat         String             @map("export_format") @db.VarChar(20)
  filePath             String             @map("file_path") @db.VarChar(255)
  fileSizeBytes        BigInt             @map("file_size_bytes")
  isPasswordProtected  Boolean            @default(false) @map("is_password_protected")
  digitalSignatureHash String?            @map("digital_signature_hash") @db.VarChar(255)
  downloadCount        Int                @default(0) @map("download_count")
  createdAt            DateTime           @default(now()) @map("created_at")
  history              RepHistory         @relation(fields: [historyId], references: [id], onDelete: Cascade)
  sharedReports        RepSharedReport[]

  @@map("rep_exports")
}

model RepPermission {
  id           String    @id @default(uuid()) @db.Uuid
  reportId     String    @map("report_id") @db.Uuid
  role         String    @db.VarChar(50)
  canView      Boolean   @default(true) @map("can_view")
  canGenerate  Boolean   @default(true) @map("can_generate")
  canDownload  Boolean   @default(true) @map("can_download")
  canShare     Boolean   @default(true) @map("can_share")
  createdAt    DateTime  @default(now()) @map("created_at")
  report       RepReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("rep_permissions")
}

model RepDashboard {
  id            String               @id @default(uuid()) @db.Uuid
  firmId        String               @map("firm_id") @db.Uuid
  name          String               @db.VarChar(150)
  dashboardType String               @default("MANAGING_PARTNER") @map("dashboard_type") @db.VarChar(50)
  isActive      Boolean              @default(true) @map("is_active")
  createdBy     String?              @map("created_by") @db.Uuid
  createdAt     DateTime             @default(now()) @map("created_at")
  widgets       RepDashboardWidget[]

  @@map("rep_dashboards")
}

model RepDashboardWidget {
  id               String       @id @default(uuid()) @db.Uuid
  dashboardId      String       @map("dashboard_id") @db.Uuid
  widgetType       String       @map("widget_type") @db.VarChar(50)
  title            String       @db.VarChar(150)
  layoutPosition   Json         @map("layout_position")
  dataSourceConfig Json         @map("data_source_config")
  createdAt        DateTime     @default(now()) @map("created_at")
  dashboard        RepDashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@map("rep_dashboard_widgets")
}

model RepSharedReport {
  id                String    @id @default(uuid()) @db.Uuid
  exportId          String    @map("export_id") @db.Uuid
  sharedBy          String    @map("shared_by") @db.Uuid
  shareChannel      String    @default("SECURE_LINK") @map("share_channel") @db.VarChar(50)
  secureLinkToken   String    @unique @map("secure_link_token") @db.VarChar(255)
  passwordHash      String?   @map("password_hash") @db.VarChar(255)
  expiresAt         DateTime? @map("expires_at")
  accessLogs        Json      @default("[]") @map("access_logs")
  createdAt         DateTime  @default(now()) @map("created_at")
  export            RepExport @relation(fields: [exportId], references: [id], onDelete: Cascade)

  @@map("rep_shared_reports")
}

model RepComment {
  id              String       @id @default(uuid()) @db.Uuid
  reportId        String       @map("report_id") @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  commentText     String       @map("comment_text")
  parentCommentId String?      @map("parent_comment_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at")
  report          RepReport    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  parentComment   RepComment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         RepComment[] @relation("CommentReplies")

  @@map("rep_comments")
}

model RepAnalyticsCache {
  id            String   @id @default(uuid()) @db.Uuid
  firmId        String   @map("firm_id") @db.Uuid
  cacheKey      String   @unique @map("cache_key") @db.VarChar(255)
  cachedPayload Json     @map("cached_payload")
  expiresAt     DateTime @map("expires_at")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("rep_analytics_cache")
}



