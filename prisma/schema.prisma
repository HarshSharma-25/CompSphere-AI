  filingTimeliness Decimal              @default(100.0) @map("filing_timeliness") @db.Decimal(5,2)
  mismatchRate     Decimal              @default(0.0) @map("mismatch_rate") @db.Decimal(5,2)
  status           String               @default("SAFE") @map("status")
  lastUpdatedAt    DateTime             @updatedAt @map("last_updated_at")
