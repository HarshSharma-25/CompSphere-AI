  @@map("sec_secretarial_logs")
}

// ==========================================
// MODULE 11: COMPLIANCE CALENDAR & ALERTS
// ==========================================

enum Authority {
  GSTN
  CBDT
  CBIC
  MCA
  EPFO
  ESIC
  STATE_GOVT
  CUSTOM
}

enum ComplianceCategory {
  GST
  INCOME_TAX
  TDS
  ROC
  PF
  ESI
  PT
  LWF
  CUSTOM
}

enum AlertSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum AlertStatus {
  PENDING
  SENT
  SNOOZED
  ACKNOWLEDGED
  FAILED
}

model SecComplianceType {
  id              String             @id @default(uuid()) @db.Uuid
  code            String             @unique // E.g., GSTR-3B, regular ITR, Form 16
  name            String
  authority       Authority
  category        ComplianceCategory
  createdAt       DateTime           @default(now()) @map("created_at")

  deadlineRules   SecDeadlineRule[]
  events          SecComplianceEvent[]
  extensions      SecGovernmentExtension[]
  slaRules        SecSlaRule[]

  @@map("cal_compliance_types")
}

model SecDeadlineRule {
  id                String            @id @default(uuid()) @db.Uuid
  complianceTypeId  String            @map("compliance_type_id") @db.Uuid
  frequency         String            // MONTHLY, QUARTERLY, ANNUALLY, ONE_TIME
  dayOfMonth        Int?              @map("day_of_month")
  monthsAfterFy     Int?              @map("months_after_fy")
  gracePeriodDays   Int               @default(0) @map("grace_period_days")
  penaltyPerDay     Decimal           @default(100.00) @map("penalty_per_day") @db.Decimal(10,2)

  type              SecComplianceType @relation(fields: [complianceTypeId], references: [id], onDelete: Cascade)

  @@map("cal_deadline_rules")
}

model SecComplianceEvent {
  id                  String             @id @default(uuid()) @db.Uuid
  companyId           String             @map("company_id") @db.Uuid
  complianceTypeId    String             @map("compliance_type_id") @db.Uuid
  title               String
  dueDate             DateTime           @map("due_date")
  status              String             @default("PENDING") // PENDING, COMPLETED, OVERDUE
  assignedUserId      String?            @map("assigned_user_id") @db.Uuid
  completedAt         DateTime?          @map("completed_at")
  completedById       String?            @map("completed_by_id") @db.Uuid
  notes               String?
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  type                SecComplianceType  @relation(fields: [complianceTypeId], references: [id], onDelete: Cascade)
  alerts              SecAlert[]

  @@index([dueDate, status])
  @@index([companyId])
  @@map("cal_compliance_events")
}

model SecGovernmentExtension {
  id                String            @id @default(uuid()) @db.Uuid
  complianceTypeId  String            @map("compliance_type_id") @db.Uuid
  originalDueDate   DateTime          @map("original_due_date")
  extendedDueDate   DateTime          @map("extended_due_date")
  circularNumber    String            @map("circular_number")
  officialLink      String?           @map("official_link")
  extendedAt        DateTime          @default(now()) @map("extended_at")

  type              SecComplianceType @relation(fields: [complianceTypeId], references: [id], onDelete: Cascade)

  @@map("cal_government_extensions")
}

model SecAlert {
  id                  String             @id @default(uuid()) @db.Uuid
  complianceEventId   String             @map("compliance_event_id") @db.Uuid
  title               String
  description         String
  triggerTime         DateTime           @map("trigger_time")
  severity            AlertSeverity      @default(MEDIUM)
  status              AlertStatus        @default(PENDING)
  snoozeUntil         DateTime?          @map("snooze_until")
  acknowledgedAt      DateTime?          @map("acknowledged_at")
  acknowledgedById    String?            @map("acknowledged_by_id") @db.Uuid
  createdAt           DateTime           @default(now()) @map("created_at")

  event               SecComplianceEvent @relation(fields: [complianceEventId], references: [id], onDelete: Cascade)
  logs                SecAlertLog[]

  @@index([triggerTime, status])
  @@map("cal_alerts")
}

model SecAlertChannel {
  id        String          @id @default(uuid()) @db.Uuid
  name      String          @unique // IN_APP, EMAIL, WHATSAPP, SMS, PUSH
  isActive  Boolean         @default(true) @map("is_active")

  logs      SecAlertLog[]

  @@map("cal_alert_channels")
}

model SecAlertLog {
  id              String          @id @default(uuid()) @db.Uuid
  alertId         String          @map("alert_id") @db.Uuid
  channelId       String          @map("channel_id") @db.Uuid
  sentAt          DateTime        @default(now()) @map("sent_at")
  status          String          @default("SENT") // SENT, DELIVERED, READ, FAILED
  errorMessage    String?         @map("error_message")

  alert           SecAlert        @relation(fields: [alertId], references: [id], onDelete: Cascade)
  channel         SecAlertChannel @relation(fields: [channelId], references: [id], onDelete: Restrict)

  @@map("cal_alert_logs")
}

model SecAlertTemplate {
  id             String          @id @default(uuid()) @db.Uuid
  templateName   String          @map("template_name")
  channel        String          // EMAIL, SMS, WHATSAPP, etc.
  bodyFormat     String          @db.Text @map("body_format")
  isDltApproved  Boolean         @default(false) @map("is_dlt_approved")
  dltTemplateId  String?         @map("dlt_template_id")

  @@map("cal_alert_templates")
}

model SecComplianceScore {
  id                     String      @id @default(uuid()) @db.Uuid
  companyId              String      @map("company_id") @db.Uuid
  calculationDate        DateTime    @default(now()) @map("calculation_date")
  gstScore               Decimal     @map("gst_score") @db.Decimal(5,2)
  tdsScore               Decimal     @map("tds_score") @db.Decimal(5,2)
  taxScore               Decimal     @map("tax_score") @db.Decimal(5,2)
  rocScore               Decimal     @map("roc_score") @db.Decimal(5,2)
  pfEsiScore             Decimal     @map("pf_esi_score") @db.Decimal(5,2)
  docSubmissionScore     Decimal     @map("doc_submission_score") @db.Decimal(5,2)
  noticeResponseScore    Decimal     @map("notice_response_score") @db.Decimal(5,2)
  totalScore             Decimal     @map("total_score") @db.Decimal(5,2)
  grade                  String      // EXCELLENT, GOOD, FAIR, POOR, CRITICAL

  @@index([companyId, calculationDate])
  @@map("cal_compliance_scores")
}

model SecClientHealth {
  id             String      @id @default(uuid()) @db.Uuid
  companyId      String      @unique @map("company_id") @db.Uuid
  scoreHistory   Json        @map("score_history") // Array of scores over time
  currentGrade   String      @map("current_grade")
  trend          String      @default("STABLE") // UP, DOWN, STABLE
  lastUpdatedAt  DateTime    @default(now()) @map("last_updated_at")

  @@map("cal_client_health")
}

model SecComplianceRiskItem {
  id             String      @id @default(uuid()) @db.Uuid
  companyId      String      @map("company_id") @db.Uuid
  riskType       String      @map("risk_type")
